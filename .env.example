# Copy to .env and fill in your values
# cp .env.example .env

# Supabase (Strategy Exchange)
# Get from https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OpenAI API (used by server/proxy - NOT exposed to browser)
OPENAI_API_KEY=sk-your-openai-api-key

# Login credentials (stored in env, not in source code)
VITE_LOGIN_USERNAME=your-username
VITE_LOGIN_PASSWORD=your-password
